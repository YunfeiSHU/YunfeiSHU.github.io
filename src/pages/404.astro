---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout title="404" description="页面不存在">
    <meta slot="head" name="robots" content="noindex">
    <div class="card-base p-8 text-center md:p-12">
        <div class="text-6xl font-bold text-[var(--primary)] md:text-7xl">404</div>
        <h1 class="mt-3 text-3xl font-bold text-90">页面不存在</h1>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-75">
            你访问的页面可能已被移动、删除，或者地址输入有误。
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href={url("/")} class="btn-regular h-10 rounded-lg px-4 text-sm font-bold active:scale-95">
                返回首页
                <Icon name="material-symbols:home-outline-rounded" class="ml-2 text-[1.1rem]"></Icon>
            </a>
            <a href={url("/archive/")} class="btn-regular h-10 rounded-lg px-4 text-sm font-bold active:scale-95">
                浏览归档
                <Icon name="material-symbols:chevron-right-rounded" class="ml-1 text-[1.1rem]"></Icon>
            </a>
        </div>
    </div>
</MainGridLayout>

---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	getCategoryList,
	getSortedPostsList,
	getTagList,
} from "../utils/content-utils";

const [sortedPostsList, allTags, allCategories] = await Promise.all([
	getSortedPostsList(),
	getTagList(),
	getCategoryList(),
]);
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <ArchivePanel sortedPosts={sortedPostsList} allTags={allTags} allCategories={allCategories} client:only="svelte"></ArchivePanel>
</MainGridLayout>


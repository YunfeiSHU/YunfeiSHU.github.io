---
import { Icon } from "astro-icon/components";
import { homeConfig, profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
---

<section class="card-base mb-4 p-6 md:p-8" aria-label="个人简介">
    <div class="flex flex-col gap-5">
        <div>
            <div class="text-sm font-bold text-[var(--primary)]">Hello, I'm {profileConfig.name}</div>
            <h1 class="mt-1 text-3xl font-bold text-90 md:text-4xl">YunfeiSHU's Blog</h1>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-75">{homeConfig.intro}</p>
        </div>

        <div class="flex flex-wrap gap-2" aria-label="技术方向">
            {homeConfig.techStack.map((item) => (
                <span class="rounded-md bg-[var(--btn-regular-bg)] px-2.5 py-1 text-xs font-medium text-[var(--btn-content)]">
                    {item}
                </span>
            ))}
        </div>

        <div class="flex flex-wrap gap-2">
            <a
                href={url("/projects/")}
                class="btn-regular h-9 rounded-lg px-3 text-sm font-bold active:scale-95"
            >
                查看项目
                <Icon name="material-symbols:chevron-right-rounded" class="ml-1 text-[1.25rem]"></Icon>
            </a>
            <a
                href="https://github.com/YunfeiSHU"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-regular h-9 rounded-lg px-3 text-sm font-bold active:scale-95"
            >
                <Icon name="fa6-brands:github" class="mr-2 text-[1rem]"></Icon>
                GitHub
            </a>
            <a
                href={url("/about/")}
                class="btn-plain h-9 rounded-lg px-3 text-sm font-bold active:scale-95"
            >
                关于我
            </a>
        </div>
    </div>
</section>
